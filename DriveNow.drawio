        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    CUST[\&quot;CUSTOMER\&quot;] --- Cu_PK([\&quot;&lt;u&gt;CustomerNo&lt;/u&gt;\&quot;])\n    CUST --- Cu_Mail([\&quot;Email\&quot;])\n    CUST --- Cu_Addr([\&quot;Address\&quot;])\n    CUST --- Cu_Reg([\&quot;RegDate\&quot;])\n    CUST --- Cu_Ph(((\&quot;PhoneNumber\&quot;)))\n    CUST --- Cu_Blk([\&quot;IsBlacklisted\&quot;])\n    CUST --- Cu_BReas([\&quot;BlacklistReason\&quot;])\n    CUST --- Cu_BDate([\&quot;BlacklistDate\&quot;])\n\n    E_DASH2[\&quot;EMPLOYEE\&quot;] ---|1| R_Blk{\&quot;Blacklisted\&quot;} ---|N| CUST\n    style E_DASH2 stroke-dasharray: 5 5\n\n    CUST === ISA_C((\&quot;d\&quot;))\n    ISA_C --- IND[\&quot;INDIVIDUAL_CUSTOMER\&quot;]\n    IND --- I_Name([\&quot;FullName\&quot;])\n    IND --- I_DOB([\&quot;DOB\&quot;])\n    IND --- I_NID([\&quot;NationalID\&quot;])\n    IND --- I_Pass([\&quot;PassportNo\&quot;])\n    IND --- I_Lic([\&quot;LicenseNo\&quot;])\n    IND --- I_Cnt([\&quot;LicenseCountry\&quot;])\n    IND --- I_Exp([\&quot;LicenseExpiry\&quot;])\n    IND --- I_Pts([/\&quot;LoyaltyPoints\&quot;/])\n    IND --- I_Tier([/\&quot;LoyaltyTier\&quot;/])\n\n    ISA_C --- CORP[\&quot;CORPORATE_CUSTOMER\&quot;]\n    CORP --- Co_Name([\&quot;CompanyName\&quot;])\n    CORP --- Co_Tax([\&quot;TaxRegNo\&quot;])\n    CORP --- Co_Cont([\&quot;ContactPerson\&quot;])\n    CORP --- Co_Cred([\&quot;CreditLimit\&quot;])\n\n    CORP ---|1| R_Auth{{\&quot;Has_Driver\&quot;}} ===|N| DRIV[[\&quot;AUTHORIZED_DRIVER\&quot;]]\n    DRIV --- D_PK([\&quot;&lt;u&gt;DriverSeqNo&lt;/u&gt;\&quot;])\n    DRIV --- D_Name([\&quot;FullName\&quot;])\n    DRIV --- D_Lic([\&quot;LicenseNo\&quot;])\n    DRIV --- D_Exp([\&quot;LicenseExpiry\&quot;])\n    DRIV --- D_Ph([\&quot;Phone\&quot;])\n\n    CORP ---|M| R_Disc{\&quot;Corp_Discount\&quot;} ---|N| CAT_DASH[\&quot;CAR_CATEGORY\&quot;]\n    style CAT_DASH stroke-dasharray: 5 5\n    R_Disc --- Di_Pct([\&quot;DiscountPct\&quot;])\n    R_Disc --- Di_Start([\&quot;StartDate\&quot;])\n    R_Disc --- Di_End([\&quot;EndDate\&quot;])\n\n    IND ---|1| R_Loy{\&quot;Has_Points\&quot;} ===|N| LOY[\&quot;LOYALTY_TRANSACTION\&quot;]\n    LOY --- Ly_PK([\&quot;&lt;u&gt;LoyaltyTxID&lt;/u&gt;\&quot;])\n    LOY --- Ly_DT([\&quot;TxDate\&quot;])\n    LOY --- Ly_Type([\&quot;TxType\&quot;])\n    LOY --- Ly_Pts([\&quot;Points\&quot;])\n\n    PROMO[\&quot;PROMOTION\&quot;] --- Pr_PK([\&quot;&lt;u&gt;PromoCode&lt;/u&gt;\&quot;])\n    PROMO --- Pr_Pct([\&quot;DiscountPct\&quot;])\n    PROMO --- Pr_From([\&quot;ValidFrom\&quot;])\n    PROMO --- Pr_To([\&quot;ValidTo\&quot;])\n    PROMO --- Pr_Max([\&quot;MaxUses\&quot;])\n    PROMO --- Pr_Used([/\&quot;TimesUsed\&quot;/])\n\n    RES[\&quot;RESERVATION\&quot;] --- Re_PK([\&quot;&lt;u&gt;ReservationNo&lt;/u&gt;\&quot;])\n    RES --- Re_Cr([\&quot;CreatedDT\&quot;])\n    RES --- Re_Pu([\&quot;ReqPickupDT\&quot;])\n    RES --- Re_Rt([\&quot;ReqReturnDT\&quot;])\n    RES --- Re_St([\&quot;Status\&quot;])\n\n    CUST ---|1| R_Makes{\&quot;Makes\&quot;} ===|N| RES\n    RES ---|N| R_UsesPr{\&quot;Uses_Promo\&quot;} ---|1| PROMO\n\n    RENT[\&quot;RENTAL\&quot;] --- Rn_PK([\&quot;&lt;u&gt;RentalNo&lt;/u&gt;\&quot;])\n    RENT --- Rn_PuDT([\&quot;PickupDT\&quot;])\n    RENT --- Rn_ExDT([\&quot;ExpectedReturnDT\&quot;])\n    RENT --- Rn_AcDT([\&quot;ActualReturnDT\&quot;])\n    RENT --- Rn_PuOd([\&quot;PickupOdometer\&quot;])\n    RENT --- Rn_RtOd([\&quot;ReturnOdometer\&quot;])\n    RENT --- Rn_PuFl([\&quot;PickupFuelPct\&quot;])\n    RENT --- Rn_RtFl([\&quot;ReturnFuelPct\&quot;])\n    RENT --- Rn_Late([\&quot;LateFee\&quot;])\n    RENT --- Rn_Rate([\&quot;AppliedDailyRate\&quot;])\n\n    RES ---|1| R_Conv{\&quot;Converts_To\&quot;} ---|1| RENT\n    RENT ---|1 Original| R_Ext{\&quot;Extends\&quot;} ---|1 Extension| RENT\n    LOY ---|N| R_Earn{\&quot;Earned_From\&quot;} ---|1| RENT\n\n    EXT[\&quot;EXTRA\&quot;] --- Ex_PK([\&quot;&lt;u&gt;ExtraCode&lt;/u&gt;\&quot;])\n    EXT --- Ex_Name([\&quot;ExtraName\&quot;])\n    EXT --- Ex_Chg([\&quot;CurrentDailyCharge\&quot;])\n    RENT ---|M| R_IncEx{\&quot;Includes_Extra\&quot;} ---|N| EXT\n    R_IncEx --- IE_Qty([\&quot;Quantity\&quot;])\n    R_IncEx --- IE_Rate([\&quot;ChargedDailyRate\&quot;])\n\n    INS[\&quot;INSURANCE_PACKAGE\&quot;] --- In_PK([\&quot;&lt;u&gt;PackageCode&lt;/u&gt;\&quot;])\n    INS --- In_Name([\&quot;PackageName\&quot;])\n    INS --- In_Pr([\&quot;CurrentDailyPrice\&quot;])\n    INS --- In_Cov([\&quot;MaxCoverage\&quot;])\n    INS --- In_Ded([\&quot;Deductible\&quot;])\n    RENT ---|M| R_Cov{\&quot;Covered_By\&quot;} ---|N| INS\n    R_Cov --- CI_Pr([\&quot;ChargedDailyPrice\&quot;])&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="_V-opnD0JRKE9N_4dpj3-1">
