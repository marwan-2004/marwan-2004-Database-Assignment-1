        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    RN_DASH[\&quot;RENTAL\&quot;] ---|1| R_HasDmg{{\&quot;Has_Damage\&quot;}} ===|N| DMG[[\&quot;DAMAGE_REPORT\&quot;]]\n    style RN_DASH stroke-dasharray: 5 5\n    DMG --- Dg_PK([\&quot;&lt;u&gt;ReportSeqNo&lt;/u&gt;\&quot;])\n    DMG --- Dg_Desc([\&quot;Description\&quot;])\n    DMG --- Dg_Sev([\&quot;Severity\&quot;])\n    DMG --- Dg_Cost([\&quot;EstRepairCost\&quot;])\n    DMG --- Dg_Ph(((\&quot;PhotoURL\&quot;)))\n\n    DMG ===|N| R_RepBy{\&quot;Reported_By\&quot;} ---|1| E_DASH3[\&quot;EMPLOYEE\&quot;]\n    style E_DASH3 stroke-dasharray: 5 5\n\n    VIOL[\&quot;TRAFFIC_VIOLATION\&quot;] --- Vl_PK([\&quot;&lt;u&gt;ViolationNo&lt;/u&gt;\&quot;])\n    VIOL --- Vl_DT([\&quot;ViolationDT\&quot;])\n    VIOL --- Vl_Loc([\&quot;Location\&quot;])\n    VIOL --- Vl_Type([\&quot;ViolationType\&quot;])\n    VIOL --- Vl_Fine([\&quot;FineAmount\&quot;])\n    VIOL ===|N| R_Viol{\&quot;Occurred_In\&quot;} ---|1| RN_DASH\n\n    FB[\&quot;FEEDBACK\&quot;] --- Fb_PK([\&quot;&lt;u&gt;FeedbackID&lt;/u&gt;\&quot;])\n    FB --- Fb_Rat([\&quot;Rating\&quot;])\n    FB --- Fb_Com([\&quot;Comment\&quot;])\n    FB --- Fb_Sub([\&quot;SubmittedDate\&quot;])\n    FB ===|1| R_Fb{\&quot;Has_Feedback\&quot;} ---|1| RN_DASH\n\n    JOB[\&quot;JOB_CARD\&quot;] --- Jb_PK([\&quot;&lt;u&gt;JobNo&lt;/u&gt;\&quot;])\n    JOB --- Jb_In([\&quot;DateIn\&quot;])\n    JOB --- Jb_Out([\&quot;DateOut\&quot;])\n    JOB --- Jb_Type([\&quot;WorkType\&quot;])\n    JOB --- Jb_Cost([\&quot;TotalCost\&quot;])\n\n    JOB ===|N| R_Serv{\&quot;Services\&quot;} ---|1| V_DASH[\&quot;VEHICLE\&quot;]\n    style V_DASH stroke-dasharray: 5 5\n    DMG ---|1| R_Caus{\&quot;Causes_Job\&quot;} ---|1| JOB\n\n    JOB ===|M| R_Work{\&quot;Worked_By\&quot;} ---|N| M_DASH[\&quot;MECHANIC\&quot;]\n    style M_DASH stroke-dasharray: 5 5\n    R_Work --- Wk_Hrs([\&quot;HoursSpent\&quot;])\n\n    PART[\&quot;PART\&quot;] --- Pt_PK([\&quot;&lt;u&gt;Par